# Frontend environment variables (Vite)
#
# Leave VITE_API_URL unset for the default same-origin setup:
#   - dev:  Vite proxies /api -> http://localhost:5000 (see vite.config.ts)
#   - prod: Express serves both the API and the built SPA
#
# Only set this if the API is hosted on a different origin:
# VITE_API_URL=https://your-api.onrender.com
