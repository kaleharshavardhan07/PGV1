# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/aapka_pg

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173

# Demo OTP (simulated SMS/WhatsApp OTP for tenant login). Matches the frontend demo code 1234.
DEMO_OTP=1234
