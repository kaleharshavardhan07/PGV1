# Server
PORT=5000
NODE_ENV=development

# Neon (serverless PostgreSQL) connection string — copy it from the Neon console
# (Connection Details → pooled connection). Keep ?sslmode=require.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# For a local Postgres: postgresql://postgres:postgres@localhost:5432/aapka_pg
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aapka_pg

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173
