# Server
PORT=5000
NODE_ENV=development

# Neon (serverless PostgreSQL) connection string: copy it from the Neon console
# (Connection Details → pooled connection). Keep ?sslmode=require.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# For a local Postgres: postgresql://postgres:postgres@localhost:5432/aapka_pg
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aapka_pg

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173

# Public URL of the web app (used for links inside emails)
PUBLIC_APP_URL=http://localhost:5173

# Platform admin bootstrap: created at startup if it does not exist yet (never overwritten).
# Remove these two lines after the first start if you prefer.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email through Proton Mail SMTP submission (optional; mail is skipped when unset).
# Needs a paid Proton plan with a custom domain. In Proton: Settings → IMAP/SMTP →
# SMTP tokens → Generate token for a custom-domain address, then:
#   SMTP_USER  = that address            SMTP_TOKEN = the generated token
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=
SMTP_TOKEN=
MAIL_FROM=
